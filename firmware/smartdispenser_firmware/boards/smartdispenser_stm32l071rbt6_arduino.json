{
  "build": {
    "cpu": "cortex-m0plus",
    "extra_flags": "-DSTM32L0 -DSTM32L071xx",
    "f_cpu": "2097152L",
    "ldscript": "boards/STM32L071RBTX_FLASH.ld",
    "arduino": {
      "board": "GENERIC_L071RBTX",
      "variant_h": "variant_generic.h"
    },
    "mcu": "stm32l071rbt6",
    "product_line": "STM32L071xx",
    "variant": "STM32L0xx/L071R(B-Z)T"
  },
  "debug": {
    "default_tools": ["stlink"],
    "jlink_device": "STM32L071RB",
    "openocd_target": "stm32l0",
    "openocd_extra_args": [
      "-f", "D:/IoT/SmartDispenser/firmware/smartdispenser_firmware/boards/stm32l071rb_dualbank_extra.cfg"
    ],
    "svd_path": "STM32L07x.svd"
  },
  "frameworks": ["arduino", "cmsis"],
  "name": "SmartDispenser STM32L071RBT6 Arduino",
  "upload": {
    "maximum_ram_size": 20480,
    "maximum_size": 131072,
    "protocol": "stlink",
    "protocols": ["stlink", "cmsis-dap", "jlink", "blackmagic"]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32l071rb.html",
  "vendor": "STMicroelectronics"
}
